<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1180.0"
           style="-fx-background-color: #0f172a;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eventify.controller.LoginController">

    <BorderPane maxHeight="560.0" maxWidth="850.0"
                style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1;">

        <!-- Left Branding Panel -->
        <left>
            <VBox alignment="CENTER_LEFT" prefWidth="340.0" spacing="16.0"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 11 0 0 11;">
                <padding>
                    <Insets bottom="36.0" left="32.0" right="32.0" top="36.0"/>
                </padding>

                <Label text="EVENTIFY" textFill="#38bdf8">
                    <font>
                        <Font name="System Bold" size="30.0"/>
                    </font>
                </Label>

                <Label text="University Event Management &amp; Coordination System"
                       textFill="#f8fafc" wrapText="true">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>

                <Label text="Manage university workshops, programming contests, seminars, schedules, tasks, attendance, and leaderboards in one unified desktop platform."
                       textFill="#cbd5e1" wrapText="true">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>

                <VBox spacing="6.0" style="-fx-background-color: #0f172a; -fx-padding: 14; -fx-background-radius: 8;">
                    <Label text="Default SQLite Accounts:" textFill="#38bdf8">
                        <font>
                            <Font name="System Bold" size="12.0"/>
                        </font>
                    </Label>
                    <Label text="Organizer:  admin / admin123" textFill="#e2e8f0">
                        <font>
                            <Font name="Consolas" size="12.0"/>
                        </font>
                    </Label>
                    <Label text="Participant: 2307032 / student123" textFill="#e2e8f0">
                        <font>
                            <Font name="Consolas" size="12.0"/>
                        </font>
                    </Label>
                    <Label text="Or Sign Up with any new Roll / ID!" textFill="#38bdf8">
                        <font>
                            <Font size="11.0"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>
        </left>

        <!-- Right Sign In / Sign Up Form Panel -->
        <center>
            <VBox alignment="CENTER_LEFT" spacing="16.0">
                <padding>
                    <Insets bottom="34.0" left="42.0" right="42.0" top="34.0"/>
                </padding>

                <VBox spacing="4.0">
                    <Label text="Sign In or Sign Up" textFill="#0f172a">
                        <font>
                            <Font name="System Bold" size="24.0"/>
                        </font>
                    </Label>
                    <Label text="Enter your Roll / ID and password to Sign In, or click Sign Up to register a new ID" textFill="#64748b" wrapText="true">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Label>
                </VBox>

                <GridPane hgap="10.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="100.0"/>
                    </columnConstraints>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Roll / User ID *" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="38.0" maxWidth="Infinity"
                                   promptText="Enter Roll or ID (e.g., 2307032 or admin)"
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Password *" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" onAction="#handleLogin" prefHeight="38.0" maxWidth="Infinity"
                                       promptText="Enter password"
                                       style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ProgressIndicator fx:id="loadingIndicator" maxHeight="22.0" maxWidth="22.0" visible="false" managed="false"/>
                    <Label fx:id="statusLabel" text="" textFill="#dc2626" wrapText="true">
                        <font>
                            <Font name="System Bold" size="12.0"/>
                        </font>
                    </Label>
                </HBox>

                <HBox spacing="10.0">
                    <Button fx:id="loginButton" onAction="#handleLogin" prefHeight="40.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Sign In"/>
                    <Button fx:id="signUpButton" onAction="#handleSignUp" prefHeight="40.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #16a34a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Sign Up"/>
                    <Button fx:id="exitButton" onAction="#handleExit" prefHeight="40.0" prefWidth="90.0"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Exit"/>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Quick Fill:" textFill="#64748b">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Label>
                    <Button onAction="#handleFillOrganizer"
                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #0369a1; -fx-border-color: #bae6fd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"
                            text="Organizer (admin)"/>
                    <Button onAction="#handleFillParticipant"
                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f766e; -fx-border-color: #99f6e4; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"
                            text="Participant (Roll: 2307032)"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
