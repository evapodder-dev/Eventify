<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1180.0"
            style="-fx-background-color: #f1f5f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventify.controller.EventController">

    <left>
        <VBox prefWidth="235.0" spacing="8.0" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets bottom="24.0" left="18.0" right="18.0" top="24.0"/>
            </padding>

            <Label text="EVENTIFY" textFill="#38bdf8">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Event Management" textFill="#94a3b8">
                <font>
                    <Font size="12.0"/>
                </font>
                <padding>
                    <Insets bottom="16.0"/>
                </padding>
            </Label>

            <Button maxWidth="Infinity" onAction="#goToDashboard" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Dashboard"/>
            <Button fx:id="navEventsBtn" maxWidth="Infinity" onAction="#goToEvents" prefHeight="38.0"
                    style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Events"/>
            <Button fx:id="navParticipantsBtn" maxWidth="Infinity" onAction="#goToParticipants" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Participants &amp; Attendance"/>
            <Button maxWidth="Infinity" onAction="#goToSchedule" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Schedule"/>
            <Button fx:id="navTasksBtn" maxWidth="Infinity" onAction="#goToTasks" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Tasks"/>
            <Button maxWidth="Infinity" onAction="#goToLeaderboard" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Leaderboard"/>
            <Button maxWidth="Infinity" onAction="#goToApiEvents" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="API Events"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="38.0"
                    style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Logout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
            </padding>
            <!-- Page History Navigation Bar (Back / Forward / Breadcrumb / Quick Jump) -->
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #e2e8f0; -fx-padding: 8 14; -fx-background-radius: 8;">
                <Button fx:id="backButton" onAction="#handleGoBack" prefHeight="30.0"
                        style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="&#8592; Back"/>
                <Button fx:id="forwardButton" onAction="#handleGoForward" prefHeight="30.0"
                        style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Forward &#8594;"/>
                <Button onAction="#goToDashboard" prefHeight="30.0"
                        style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Home (Dashboard)"/>
                <Label fx:id="breadcrumbLabel" text="Path: [Dashboard]" textFill="#334155" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                    <padding>
                        <Insets left="8.0"/>
                    </padding>
                </Label>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 14 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitleLabel" text="Event Management" textFill="#0f172a">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <Label fx:id="statusLabel" text="Browse, search, and manage university events" textFill="#64748b">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Label>
                </VBox>
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="24.0" maxWidth="24.0" visible="false"/>
                <Button fx:id="exportJsonBtn" onAction="#handleExportJson" prefHeight="34.0"
                        style="-fx-background-color: #0f766e; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Export Event (JSON)"/>
                <Button fx:id="importJsonBtn" onAction="#handleImportJson" prefHeight="34.0"
                        style="-fx-background-color: #7c3aed; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Import Event (JSON)"/>
            </HBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 16 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <GridPane fx:id="eventFormGrid" hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Event Name *" textFill="#334155"/>
                        <TextField fx:id="eventNameField" promptText="e.g., Programming Contest"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Category *" textFill="#334155"/>
                        <ComboBox fx:id="categoryCombo" maxWidth="Infinity" promptText="Select Category"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Date *" textFill="#334155"/>
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" promptText="Select Date"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="Status *" textFill="#334155"/>
                        <ComboBox fx:id="statusCombo" maxWidth="Infinity" promptText="Select Status"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Start Time (HH:mm) *" textFill="#334155"/>
                        <TextField fx:id="startTimeField" promptText="09:00"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="End Time (HH:mm) *" textFill="#334155"/>
                        <TextField fx:id="endTimeField" promptText="14:00"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Venue *" textFill="#334155"/>
                        <TextField fx:id="venueField" promptText="e.g., CSE Building 301"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <Label text="Organizer *" textFill="#334155"/>
                        <TextField fx:id="organizerField" promptText="e.g., EVA PODDER"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Max Participants *" textFill="#334155"/>
                        <TextField fx:id="maxParticipantsField" promptText="100"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3">
                        <Label text="Description" textFill="#334155"/>
                        <TextField fx:id="descriptionField" promptText="Brief description of the event"/>
                    </VBox>
                </GridPane>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button fx:id="addEventBtn" onAction="#handleAddEvent" prefHeight="34.0"
                            style="-fx-background-color: #16a34a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Add Event"/>
                    <Button fx:id="updateEventBtn" onAction="#handleUpdateEvent" prefHeight="34.0"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Update Event"/>
                    <Button fx:id="deleteEventBtn" onAction="#handleDeleteEvent" prefHeight="34.0"
                            style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Delete Event"/>
                    <Button fx:id="registerEventBtn" onAction="#handleRegisterSelectedEvent" prefHeight="34.0"
                            style="-fx-background-color: #16a34a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Register for Selected Event"/>
                    <Button fx:id="myRegistrationsBtn" onAction="#handleViewMyRegistrations" prefHeight="34.0"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="My Registered Events"/>
                    <Button onAction="#handleViewDetails" prefHeight="34.0"
                            style="-fx-background-color: #475569; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="View Event Details"/>
                    <Button fx:id="clearEventBtn" onAction="#handleClearForm" prefHeight="34.0"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Clear"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleOpenEventSchedule" prefHeight="34.0"
                            style="-fx-background-color: #0f766e; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Event Schedule &#8594;"/>
                    <Button onAction="#handleOpenEventLeaderboard" prefHeight="34.0"
                            style="-fx-background-color: #7c3aed; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Event Leaderboard &#8594;"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #ffffff; -fx-padding: 16 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="searchField" onKeyReleased="#handleSearch" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                               promptText="Search by name, category, venue, or organizer..."/>
                    <ComboBox fx:id="filterStatusCombo" onAction="#handleSearch" prefWidth="160.0"
                              promptText="Filter by Status"/>
                    <Button onAction="#handleSearch"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Search"/>
                    <Button onAction="#loadEvents"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Reset"/>
                </HBox>

                <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" text="Event Name"/>
                        <TableColumn fx:id="colCategory" text="Category"/>
                        <TableColumn fx:id="colDate" text="Date"/>
                        <TableColumn fx:id="colStart" text="Start"/>
                        <TableColumn fx:id="colEnd" text="End"/>
                        <TableColumn fx:id="colVenue" text="Venue"/>
                        <TableColumn fx:id="colOrganizer" text="Organizer"/>
                        <TableColumn fx:id="colMax" text="Max"/>
                        <TableColumn fx:id="colStatus" text="Status"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
