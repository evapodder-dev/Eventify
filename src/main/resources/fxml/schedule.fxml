<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1180.0"
            style="-fx-background-color: #f1f5f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventify.controller.ScheduleController">

    <left>
        <VBox prefWidth="235.0" spacing="8.0" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets bottom="24.0" left="18.0" right="18.0" top="24.0"/>
            </padding>

            <Label text="EVENTIFY" textFill="#38bdf8">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Schedule Management" textFill="#94a3b8">
                <font>
                    <Font size="12.0"/>
                </font>
                <padding>
                    <Insets bottom="16.0"/>
                </padding>
            </Label>

            <Button maxWidth="Infinity" onAction="#goToDashboard" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Dashboard"/>
            <Button maxWidth="Infinity" onAction="#goToEvents" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Events"/>
            <Button maxWidth="Infinity" onAction="#goToParticipants" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Participants &amp; Attendance"/>
            <Button maxWidth="Infinity" onAction="#goToSchedule" prefHeight="38.0"
                    style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Schedule"/>
            <Button maxWidth="Infinity" onAction="#goToTasks" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Tasks"/>
            <Button maxWidth="Infinity" onAction="#goToLeaderboard" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Leaderboard"/>
            <Button maxWidth="Infinity" onAction="#goToApiEvents" prefHeight="38.0"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #e2e8f0; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="API Events"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="38.0"
                    style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Logout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
            </padding>
            <!-- Page History Navigation Bar (Back / Forward / Breadcrumb / Quick Jump) -->
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #e2e8f0; -fx-padding: 8 14; -fx-background-radius: 8;">
                <Button fx:id="backButton" onAction="#handleGoBack" prefHeight="30.0"
                        style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="&#8592; Back"/>
                <Button fx:id="forwardButton" onAction="#handleGoForward" prefHeight="30.0"
                        style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Forward &#8594;"/>
                <Button onAction="#goToDashboard" prefHeight="30.0"
                        style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 12; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Home (Dashboard)"/>
                <Label fx:id="breadcrumbLabel" text="Path: [Dashboard]" textFill="#334155" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                    <padding>
                        <Insets left="8.0"/>
                    </padding>
                </Label>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 14 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Event Schedule Management" textFill="#0f172a">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <Label fx:id="statusLabel" text="Organize session timelines, dates, times, and venues for each event" textFill="#64748b">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 16 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="34.0"/>
                        <ColumnConstraints percentWidth="33.0"/>
                        <ColumnConstraints percentWidth="33.0"/>
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Event *" textFill="#334155"/>
                        <ComboBox fx:id="eventCombo" maxWidth="Infinity" promptText="Select Event"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Activity Name *" textFill="#334155"/>
                        <TextField fx:id="activityField" promptText="e.g., Opening Ceremony / Main Contest"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Date *" textFill="#334155"/>
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" promptText="Select Date"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Start Time (HH:mm) *" textFill="#334155"/>
                        <TextField fx:id="startTimeField" promptText="09:00"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="End Time (HH:mm) *" textFill="#334155"/>
                        <TextField fx:id="endTimeField" promptText="12:00"/>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Venue *" textFill="#334155"/>
                        <TextField fx:id="venueField" promptText="e.g., Lab 301 / Auditorium"/>
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#handleAddSchedule" prefHeight="34.0"
                            style="-fx-background-color: #16a34a; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Add Schedule"/>
                    <Button onAction="#handleUpdateSchedule" prefHeight="34.0"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Edit Schedule"/>
                    <Button onAction="#handleDeleteSchedule" prefHeight="34.0"
                            style="-fx-background-color: #dc2626; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Delete Schedule"/>
                    <Button onAction="#handleViewDetails" prefHeight="34.0"
                            style="-fx-background-color: #475569; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="View Schedule Details"/>
                    <Button onAction="#handleClearForm" prefHeight="34.0"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-padding: 0 16; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Clear"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="filterEventCombo" onAction="#handleFilterByEvent" prefWidth="240.0"
                              promptText="Filter by Event"/>
                    <Button onAction="#loadSchedules"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="View All"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #ffffff; -fx-padding: 16 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="65.0" text="ID"/>
                        <TableColumn fx:id="colEvent" prefWidth="240.0" text="Event"/>
                        <TableColumn fx:id="colActivity" prefWidth="230.0" text="Activity Name"/>
                        <TableColumn fx:id="colDate" prefWidth="110.0" text="Date"/>
                        <TableColumn fx:id="colStart" prefWidth="90.0" text="Start Time"/>
                        <TableColumn fx:id="colEnd" prefWidth="90.0" text="End Time"/>
                        <TableColumn fx:id="colVenue" prefWidth="180.0" text="Venue"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>

